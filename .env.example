# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Wikimedia etiquette -----------------------------------------------------
# Contact info included in the User-Agent sent to Wikimedia APIs.
# Use an address or URL you are happy to make public, e.g. a GitHub issues page.
WIKIPULSE_CONTACT=https://github.com/jinam-shah/wikipulse/issues

# --- App connections (from your laptop to the docker stack) ------------------
WIKIPULSE_KAFKA_BOOTSTRAP=localhost:19092
WIKIPULSE_DATABASE_URL=postgresql://wikipulse:wikipulse@localhost:5432/wikipulse

# --- Postgres container --------------------------------------------------------
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=wikipulse
POSTGRES_DB=wikipulse
POSTGRES_PORT=5432

# --- Ports (change if something on your machine already uses them) -----------
REDPANDA_KAFKA_PORT=19092
REDPANDA_CONSOLE_PORT=8088
REDPANDA_ADMIN_PORT=19644
AIRFLOW_PORT=8081

# --- Airflow (local only) -----------------------------------------------------
# Generate a Fernet key with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-local-only
# On Linux set this to the output of `id -u`. On Windows/macOS leave it at 50000.
AIRFLOW_UID=50000

# --- Producer (Phase 1) -------------------------------------------------------
# Comma-separated wiki IDs (enwiki, dewiki, frwiki, ...) and namespace numbers (0 = articles).
WIKIPULSE_WIKIS=enwiki
WIKIPULSE_NAMESPACES=0
WIKIPULSE_EDITS_TOPIC=wikipulse.edits.v1
WIKIPULSE_DLQ_TOPIC=wikipulse.edits.dlq.v1
WIKIPULSE_CHECKPOINT_PATH=data/checkpoints/producer.json
